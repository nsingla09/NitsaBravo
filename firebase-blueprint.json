{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and points balance",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique identifier for the user" },
        "email": { "type": "string", "format": "email", "description": "The user's email address" },
        "displayName": { "type": "string", "description": "The user's display name" },
        "photoURL": { "type": "string", "description": "The user's photo URL" },
        "pointsBalance": { "type": "number", "description": "The current balance of Bravo points" },
        "lastReadRemarks": { "type": "object", "description": "Map of saleId to remarksCount last read by user" }
      },
      "required": ["uid", "email", "displayName", "pointsBalance"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A record of Bravo points awarded",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string", "description": "The UID of the user awarding the points" },
        "fromName": { "type": "string", "description": "The name of the user awarding the points" },
        "toUid": { "type": "string", "description": "The UID of the user receiving the points" },
        "toName": { "type": "string", "description": "The name of the user receiving the points" },
        "points": { "type": "number", "description": "The number of points awarded" },
        "reason": { "type": "string", "description": "The reason for the award" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the transaction occurred" }
      },
      "required": ["fromUid", "fromName", "toUid", "toName", "points", "reason", "createdAt"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Employee master record",
      "type": "object",
      "properties": {
        "employeeCode": { "type": "string", "description": "Auto-generated employee code" },
        "name": { "type": "string", "description": "Employee name" },
        "target": { "type": "number", "description": "Target amount" },
        "position": { "type": "string", "description": "Employee position" },
        "joiningDate": { "type": "string", "format": "date", "description": "Joining date" },
        "joiningWeek": { "type": "string", "description": "Joining week" },
        "bde": { "type": "string", "description": "Business Development Executive" },
        "status": { "type": "string", "enum": ["Active", "Deactive"], "description": "Active or Deactive status" },
        "isAssocBDE": { "type": "boolean", "description": "If true, employee acts as Associate BDE" },
        "week1Target": { "type": "number", "description": "1st week target percentage" },
        "week2Target": { "type": "number", "description": "2nd week target percentage" },
        "week3Target": { "type": "number", "description": "3rd week target percentage" },
        "week4Target": { "type": "number", "description": "4th week target percentage" },
        "week5Target": { "type": "number", "description": "5th week target percentage" },
        "week6Target": { "type": "number", "description": "6th week target percentage" },
        "salary": { "type": "number", "description": "Monthly salary of the employee" },
        "completedTrainings": { "type": "array", "items": { "type": "string" }, "description": "Array of completed training material IDs" }
      },
      "required": ["employeeCode", "name", "target", "position", "joiningDate", "status", "salary"]
    },
    "Week": {
      "title": "Week",
      "description": "Week master record defining date ranges",
      "type": "object",
      "properties": {
        "weekName": { "type": "string", "description": "Name of the week (e.g., Week 1)" },
        "startDate": { "type": "string", "format": "date", "description": "Start date of the week" },
        "endDate": { "type": "string", "format": "date", "description": "End date of the week" },
        "month": { "type": "string", "description": "Month and year (e.g., March 2026)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the week was created" }
      },
      "required": ["weekName", "startDate", "endDate", "month"]
    },
    "BDE": {
      "title": "BDE",
      "description": "Business Development Executive master record",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "BDE name" },
        "phone": { "type": "string", "description": "BDE phone number" },
        "email": { "type": "string", "format": "email", "description": "BDE email address" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the BDE was created" }
      },
      "required": ["name"]
    },
    "Sales": {
      "title": "Sales",
      "description": "Sales master record",
      "type": "object",
      "properties": {
        "week": { "type": "string", "description": "Week range" },
        "date": { "type": "string", "format": "date", "description": "Sale date" },
        "guestName": { "type": "string", "description": "Name of the guest" },
        "agent": { "type": "string", "description": "Agent name" },
        "agentEmail": { "type": "string", "format": "email", "description": "Agent email" },
        "agentPercentage": { "type": "number", "description": "Percentage for Agent" },
        "bde": { "type": "string", "description": "BDE name" },
        "associateBde": { "type": "string", "description": "Associate BDE name" },
        "assocBdePercentage": { "type": "number", "description": "Percentage for Associate BDE" },
        "destination": { "type": "string", "description": "Destination" },
        "tripId": { "type": "string", "description": "Trip ID" },
        "tripDate": { "type": "string", "format": "date", "description": "Trip date" },
        "packageValue": { "type": "number", "description": "Package value" },
        "lessThan10Percent20k": { "type": "string", "description": "Less than 10% / 20k" },
        "ppMargin": { "type": "number", "description": "PP Margin" },
        "noOfPax": { "type": "number", "description": "Number of Pax" },
        "totalMargin": { "type": "number", "description": "Total Margin" },
        "flight": { "type": "number", "description": "Flight cost" },
        "source": { "type": "string", "description": "Source" },
        "converted": { "type": "string", "description": "Converted status" },
        "tasksPending": { "type": "string", "description": "Tasks pending" },
        "pHotel": { "type": "string", "description": "P - Hotel" },
        "pFlight": { "type": "string", "description": "P Flight" },
        "land": { "type": "string", "description": "Land status" },
        "hflIssue": { "type": "string", "description": "H+F+L issue" },
        "workPending": { "type": "string", "description": "Work pending" },
        "remarks": { "type": "string", "description": "Legacy remarks field" },
        "remarksCount": { "type": "number", "description": "Count of log entries in remarks subcollection" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the record was created" }
      },
      "required": ["week", "date", "guestName", "agent", "destination", "tripId", "packageValue"]
    },
    "Remark": {
      "title": "Remark",
      "description": "A log entry for a sale issue",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "Date of log (DD/MM/YYYY)" },
        "time": { "type": "string", "description": "Time of log (HH:mm)" },
        "userName": { "type": "string", "description": "Name of the user who added the remark" },
        "userUid": { "type": "string", "description": "UID of the user who added the remark" },
        "text": { "type": "string", "description": "The remark text" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["date", "time", "userName", "userUid", "text", "createdAt"]
    },
    "TrainingMaterial": {
      "title": "TrainingMaterial",
      "description": "Training material master record",
      "type": "object",
      "properties": {
        "remarks": { "type": "string", "description": "Remarks" },
        "module": { 
          "type": "array", 
          "items": { "type": "string", "enum": ["Sales", "Operations", "Lead"] },
          "description": "Module types" 
        },
        "points": { "type": "number", "description": "Points (1-10)" },
        "day": { "type": "number", "description": "Day (1-15)" },
        "time": { "type": "number", "description": "Time in minutes" },
        "isActive": { "type": "boolean", "description": "Active status" },
        "link": { "type": "string", "description": "Link to training material" },
        "priority": { "type": "number", "description": "Priority for sorting" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When created" }
      },
      "required": ["remarks", "module", "points", "day", "time", "isActive"]
    },
    "Role": {
      "title": "Role",
      "description": "User role and associated permissions",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the role (e.g., Admin, Manager)" },
        "permissions": { "type": "array", "items": { "type": "string" }, "description": "List of permission IDs" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the role was created" }
      },
      "required": ["name", "permissions"]
    },
    "PagePassword": {
      "title": "PagePassword",
      "description": "Password protection for application pages",
      "type": "object",
      "properties": {
        "pageId": { "type": "string", "description": "The ID of the page/tab" },
        "password": { "type": "string", "description": "The password for the page" },
        "isOpen": { "type": "boolean", "description": "Whether the page is open or password protected" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the password was last updated" }
      },
      "required": ["pageId", "password", "isOpen"]
    },
    "Incentive": {
      "title": "Incentive",
      "description": "Incentive due record",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "description": "Employee ID" },
        "employeeName": { "type": "string", "description": "Employee name" },
        "type": { "type": "string", "enum": ["Daily", "Weekly", "Monthly", "Quarterly", "Annually"], "description": "Incentive type" },
        "amount": { "type": "number", "description": "Incentive amount" },
        "date": { "type": "string", "format": "date", "description": "Date of incentive" },
        "remarks": { "type": "string", "description": "Remarks" },
        "recordedBy": { "type": "string", "description": "User who recorded the entry" },
        "recordedAt": { "type": "string", "description": "Timestamp of recording" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When created" }
      },
      "required": ["employeeId", "employeeName", "type", "amount", "date"]
    },
    "IncentivePayment": {
      "title": "IncentivePayment",
      "description": "Incentive payment record",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "description": "Employee ID" },
        "employeeName": { "type": "string", "description": "Employee name" },
        "amount": { "type": "number", "description": "Payment amount" },
        "date": { "type": "string", "format": "date", "description": "Date of payment" },
        "paymentMethod": { "type": "string", "description": "Payment method (Cash, Bank Transfer, etc.)" },
        "remarks": { "type": "string", "description": "Remarks" },
        "recordedBy": { "type": "string", "description": "User who recorded the entry" },
        "recordedAt": { "type": "string", "description": "Timestamp of recording" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When created" }
      },
      "required": ["employeeId", "employeeName", "amount", "date", "paymentMethod"]
    },
    "KnowledgeBaseEntry": {
      "title": "KnowledgeBaseEntry",
      "description": "A question and resolution entry in the knowledge base",
      "type": "object",
      "properties": {
        "question": { "type": "string", "description": "The question or issue" },
        "resolution": { "type": "string", "description": "The resolution or answer" },
        "labels": { "type": "array", "items": { "type": "string" }, "description": "Labels for easy access" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When created" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When last updated" },
        "updatedBy": { "type": "string", "description": "User who last updated the entry" }
      },
      "required": ["question", "resolution", "labels"]
    },
    "MatrixReport": {
      "title": "MatrixReport",
      "description": "Daily performance matrix report",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "description": "Employee ID" },
        "employeeName": { "type": "string", "description": "Employee name" },
        "date": { "type": "string", "format": "date", "description": "Report date" },
        "performancePoints": { "type": "number", "description": "Performance points" },
        "totalCalls": { "type": "number", "description": "Total calls" },
        "totalTalktime": { "type": "string", "description": "Total talktime" },
        "topTalktimes": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "tripId": { "type": "string" },
              "phoneNo": { "type": "string" },
              "talktime": { "type": "string" }
            }
          }
        },
        "loginTime": { "type": "string", "description": "Login time" },
        "logoutTime": { "type": "string", "description": "Logout time" },
        "breakTime": { "type": "string", "description": "Break time" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["employeeId", "employeeName", "date", "performancePoints", "totalCalls", "totalTalktime", "loginTime", "logoutTime", "breakTime"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/roles/{roleId}": {
      "schema": "Role",
      "description": "User roles and permissions"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Bravo point transactions"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Employee master records"
    },
    "/weeks/{weekId}": {
      "schema": "Week",
      "description": "Week master records"
    },
    "/bdes/{bdeId}": {
      "schema": "BDE",
      "description": "BDE master records"
    },
    "/sales/{saleId}": {
      "schema": "Sales",
      "description": "Sales master records"
    },
    "/sales/{saleId}/remarks/{remarkId}": {
      "schema": "Remark",
      "description": "Remarks log for a sale"
    },
    "/trainingMaterials/{trainingId}": {
      "schema": "TrainingMaterial",
      "description": "Training material master records"
    },
    "/pagePasswords/{pageId}": {
      "schema": "PagePassword",
      "description": "Page password configurations"
    },
    "/incentives/{incentiveId}": {
      "schema": "Incentive",
      "description": "Incentive due records"
    },
    "/incentivePayments/{paymentId}": {
      "schema": "IncentivePayment",
      "description": "Incentive payment records"
    },
    "/knowledgeBase/{entryId}": {
      "schema": "KnowledgeBaseEntry",
      "description": "Knowledge base entries"
    },
    "/matrixReports/{reportId}": {
      "schema": "MatrixReport",
      "description": "Daily performance matrix reports"
    }
  }
}
